{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "sourceMap": false,
    "rootDir": "src/",
    "outDir": "./dist",
    "esModuleInterop": true,
    "declaration": true,
    "strict": false,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
